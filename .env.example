# ─────────────────────────────────────────────
# ListingJet — Environment Configuration
# Generated by scripts/gen_env_example.py from listingjet.config.Settings —
# do not hand-edit; run `python scripts/gen_env_example.py` to regenerate
# (or `just env-example`). `just env-check` / `--check` fails CI if this
# file has drifted from Settings.
#
# Copy to .env and fill in your values. Local dev typically also sets:
#   USE_MOCK_PROVIDERS=true     (skip real Anthropic/OpenAI calls)
#   FFMPEG_BIN=/path/to/ffmpeg  (if ffmpeg isn't on PATH)
# ─────────────────────────────────────────────

# ── App ─────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
FEATURES=
TRUSTED_PROXY_COUNT=0

# ── Database — auto-converts postgresql:// to postgresql+asyncpg:// if needed ─
DATABASE_URL=  # secret
DATABASE_URL_SYNC=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_USE_PGBOUNCER=false

# ── Auth ────────────────────────────────────────
JWT_SECRET=  # secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# ── Stripe ──────────────────────────────────────
STRIPE_SECRET_KEY=  # secret
STRIPE_WEBHOOK_SECRET=  # secret
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ── Pipeline worker (runs inside the API process unless worker_enabled=false) ─
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_S=2.0
PIPELINE_TIMEOUT_HOURS=6

# ── Redis ───────────────────────────────────────
REDIS_URL=  # secret

# ── Frontend base URL — used for constructing links in transactional emails ─
FRONTEND_URL=  # secret

# ── S3 / object storage. Set s3_endpoint_url + s3_access_key_id + s3_secret_access_key ─
S3_BUCKET_NAME=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=  # secret
S3_ACCESS_KEY_ID=  # secret
S3_SECRET_ACCESS_KEY=  # secret

# ── Monitoring ──────────────────────────────────
SENTRY_DSN=  # secret
GIT_SHA=

# ── Provider API keys ───────────────────────────
OPENAI_API_KEY=  # secret
ANTHROPIC_API_KEY=  # secret
GOOGLE_API_KEY=  # secret
USE_MOCK_PROVIDERS=false
CLAUDE_FAST_MODEL=claude-haiku-4-5
CLAUDE_QUALITY_MODEL=claude-sonnet-5

# ── Google OAuth ────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=

# ── Field-level encryption (Fernet key for tenant secrets, etc.) ─
FIELD_ENCRYPTION_KEY=  # secret

# ── Canva ───────────────────────────────────────
CANVA_API_KEY=  # secret
CANVA_DEFAULT_TEMPLATE_ID=

# ── Legacy credit bundles (kept for backward compat) ─
STRIPE_PRICE_CREDIT_BUNDLE_5=
STRIPE_PRICE_CREDIT_BUNDLE_10=
STRIPE_PRICE_CREDIT_BUNDLE_25=
STRIPE_PRICE_CREDIT_BUNDLE_50=

# ── v3 tier pricing (Stripe subscription price IDs) ─
STRIPE_PRICE_LITE=
STRIPE_PRICE_ACTIVE_AGENT=
STRIPE_PRICE_TEAM=

# ── v3 tier-locked credit bundles (Stripe one-time price IDs) ─
STRIPE_PRICE_CREDIT_BUNDLE_FREE_25=
STRIPE_PRICE_CREDIT_BUNDLE_FREE_50=
STRIPE_PRICE_CREDIT_BUNDLE_FREE_100=
STRIPE_PRICE_CREDIT_BUNDLE_FREE_250=
STRIPE_PRICE_CREDIT_BUNDLE_LITE_25=
STRIPE_PRICE_CREDIT_BUNDLE_LITE_50=
STRIPE_PRICE_CREDIT_BUNDLE_LITE_100=
STRIPE_PRICE_CREDIT_BUNDLE_LITE_250=
STRIPE_PRICE_CREDIT_BUNDLE_ACTIVE_AGENT_25=
STRIPE_PRICE_CREDIT_BUNDLE_ACTIVE_AGENT_50=
STRIPE_PRICE_CREDIT_BUNDLE_ACTIVE_AGENT_100=
STRIPE_PRICE_CREDIT_BUNDLE_ACTIVE_AGENT_250=
STRIPE_PRICE_CREDIT_BUNDLE_TEAM_25=
STRIPE_PRICE_CREDIT_BUNDLE_TEAM_50=
STRIPE_PRICE_CREDIT_BUNDLE_TEAM_100=
STRIPE_PRICE_CREDIT_BUNDLE_TEAM_250=

# ── Canva OAuth2 (Phase 2 — per-tenant access) ──
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=  # secret
CANVA_REDIRECT_URI=https://api.listingjet.ai/auth/canva/callback
CANVA_FRONTEND_REDIRECT=https://listingjet.ai/settings/brand-kit

# ── Email / Notifications ───────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=  # secret
EMAIL_FROM=noreply@listingjet.ai
EMAIL_ENABLED=false
SES_ENABLED=false
RESEND_API_KEY=  # secret

# ── Video (Runway two-tier generation + ffmpeg stitching) ─
FFMPEG_BIN=ffmpeg
RUNWAY_API_KEY=  # secret
RUNWAY_INTERIOR_MODEL=gen4_turbo
RUNWAY_EXTERIOR_MODEL=veo3.1_fast
VIDEO_MUSIC_ENABLED=false
VIDEO_MUSIC_PATH=

# ── Property Lookup ─────────────────────────────
ATTOM_API_KEY=  # secret
WALK_SCORE_API_KEY=  # secret
PROPERTY_LOOKUP_CACHE_TTL=86400
PROPERTY_VERIFICATION_ENABLED=true
