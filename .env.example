# ─────────────────────────────────────────────
# ListingJet — Environment Configuration
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
# development | staging | production
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Reverse proxies in front of the app (1 behind Render, 0 for direct/local)
TRUSTED_PROXY_COUNT=0
# Comma-separated feature flags: learning, health_score,
# performance_intelligence, help_agent, microsite, webhooks,
# listing_permissions. Default is none (all off). Routers are chosen at
# app start based on this value, so enabling/disabling a flag requires a
# restart of the API and worker processes.
FEATURES=

# ── Database ─────────────────────────────────
# Async URL (used by FastAPI + the pipeline worker)
DATABASE_URL=postgresql+asyncpg://listingjet:password@localhost:5432/listingjet
# Sync URL (used by Alembic migrations only)
DATABASE_URL_SYNC=postgresql://listingjet:password@localhost:5432/listingjet

# ── Auth ─────────────────────────────────────
# Must be at least 32 characters; use a cryptographically random string
JWT_SECRET=changeme-32-chars-minimum-secret-xx
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# ── Stripe ───────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Plan price IDs from your Stripe dashboard
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...
# v3 tier price IDs
STRIPE_PRICE_LITE=
STRIPE_PRICE_ACTIVE_AGENT=
STRIPE_PRICE_TEAM=

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AWS / S3 ─────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=listingjet-dev

# ── Monitoring / Observability ───────────────
# Sentry DSN — leave blank to disable error reporting
SENTRY_DSN=
# Git commit SHA injected at deploy time (used in Sentry releases)
GIT_SHA=

# ── Feature Flags ────────────────────────────
# Shadow review: run automated checks on all approved listings
SHADOW_REVIEW_ENABLED=true
SHADOW_REVIEW_MAX_LISTINGS=100

# ── Google OAuth (Sign In With Google) ───────
GOOGLE_OAUTH_CLIENT_ID=

# ── AI Provider Keys ─────────────────────────
# Google Drive link-import (formerly GOOGLE_VISION_API_KEY, still accepted)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_FAST_MODEL=claude-haiku-4-5
CLAUDE_QUALITY_MODEL=claude-sonnet-5

# Set to true to use mock providers in tests / local dev (no real API calls)
USE_MOCK_PROVIDERS=false

# ── Video Pipeline (Runway two-tier + ffmpeg stitching) ───────
FFMPEG_BIN=ffmpeg
RUNWAY_API_KEY=
RUNWAY_INTERIOR_MODEL=gen4_turbo
RUNWAY_EXTERIOR_MODEL=veo3.1_fast
VIDEO_MUSIC_ENABLED=false
VIDEO_MUSIC_PATH=

# ── Canva Connect API ────────────────────────
CANVA_API_KEY=
CANVA_DEFAULT_TEMPLATE_ID=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=

# ── Email / Notifications ────────────────────
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@listingjet.com
# Set to true to use AWS SES instead of SMTP
SES_ENABLED=false

# ── Property Data ────────────────────────────
PROPERTY_VERIFICATION_ENABLED=false
ATTOM_API_KEY=
WALK_SCORE_API_KEY=
